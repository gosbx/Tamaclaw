{
  "name": "tamaclaw-monorepo",
  "version": "0.3.1",
  "private": true,
  "description": "Dev workspace for the tamaclaw package (OpenClaw companion display).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node --watch packages/tamaclaw/bridge/main.ts",
    "start": "node packages/tamaclaw/bridge/main.ts",
    "launch": "./launch.sh",
    "launch:kiosk": "./launch.sh --kiosk",
    "demo": "./demo.sh",
    "install-plugin": "./scripts/install-plugin.sh",
    "pack": "./scripts/pack.sh"
  },
  "engines": {
    "node": ">=23.6"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
